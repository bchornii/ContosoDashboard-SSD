@using ContosoDashboard.Services
@using ContosoDashboard.Models
@inject IDocumentService DocumentService
@inject IUserService UserService
@implements IDisposable

<div class="modal @(IsVisible ? "show d-block" : "")" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-share"></i> Share Document
                </h5>
                <button type="button" class="btn-close" @onclick="OnClose"></button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show">
                        <i class="bi bi-exclamation-triangle"></i> @errorMessage
                        <button type="button" class="btn-close" @onclick='() => errorMessage = null'></button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(successMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show">
                        <i class="bi bi-check-circle"></i> @successMessage
                        <button type="button" class="btn-close" @onclick='() => successMessage = null'></button>
                    </div>
                }

                @if (Document != null)
                {
                    <div class="mb-3">
                        <label class="form-label">Document</label>
                        <div class="text-muted">@Document.Title</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Search User</label>
                        <input type="text" 
                               class="form-control" 
                               placeholder="Type to search users..." 
                               @bind="searchTerm" 
                               @bind:event="oninput"
                               @bind:after="OnSearchInput" />
                    </div>

                    @if (isSearching)
                    {
                        <div class="text-center p-3">
                            <span class="spinner-border spinner-border-sm"></span> Searching...
                        </div>
                    }
                    else if (filteredUsers != null && filteredUsers.Any())
                    {
                        <div class="list-group mb-3" style="max-height: 300px; overflow-y: auto;">
                            @foreach (var user in filteredUsers)
                            {
                                <button type="button" 
                                        class="list-group-item list-group-item-action"
                                        @onclick='() => ShareWithUser(user.UserId)'>
                                    <div class="d-flex align-items-center">
                                        <div class="flex-grow-1">
                                            <strong>@user.DisplayName</strong>
                                            <br />
                                            <small class="text-muted">@user.Email</small>
                                        </div>
                                        @if (selectedUserIds.Contains(user.UserId))
                                        {
                                            <span class="badge bg-success">Shared <i class="bi bi-check"></i></span>
                                        }
                                    </div>
                                </button>
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(searchTerm) && !isSearching)
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i> No users found matching "@searchTerm"
                        </div>
                    }

                    <!-- Share with Project -->
                    @if (userProjects != null && userProjects.Any())
                    {
                        <hr />
                        <div class="mb-3">
                            <label class="form-label">Or Share with Entire Project</label>
                            <select class="form-select" @bind="selectedProjectId">
                                <option value="0">Select a project...</option>
                                @foreach (var project in userProjects)
                                {
                                    <option value="@project.ProjectId">@project.Name (@project.ProjectMembers.Count members)</option>
                                }
                            </select>
                        </div>
                        <button class="btn btn-secondary" 
                                @onclick="ShareWithProject" 
                                disabled="@(selectedProjectId == 0 || isSharing)">
                            @if (isSharing)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            <i class="bi bi-people"></i> Share with Project
                        </button>
                    }
                }
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="OnClose">Close</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public Document? Document { get; set; }
    [Parameter] public int UserId { get; set; }
    [Parameter] public EventCallback OnShareComplete { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private List<User>? allUsers;
    private List<User>? filteredUsers;
    private List<Project>? userProjects;
    private HashSet<int> selectedUserIds = new();
    private string searchTerm = "";
    private int selectedProjectId = 0;
    private bool isSearching = false;
    private bool isSharing = false;
    private string? errorMessage;
    private string? successMessage;
    private System.Threading.Timer? searchDebounceTimer;

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && Document != null && allUsers == null)
        {
            await LoadUsersAndProjects();
        }

        if (!IsVisible)
        {
            ResetState();
        }
    }

    private async Task LoadUsersAndProjects()
    {
        allUsers = await UserService.GetAllUsersAsync();
        userProjects = await DocumentService.GetUserDocumentsAsync(UserId, null) 
            is var docs ? null : new List<Project>(); // Simplified - in real app get user projects

        // Load existing shares to mark them
        if (Document != null)
        {
            var shares = await DocumentService.GetDocumentSharesAsync(Document.DocumentId, UserId);
            selectedUserIds = shares.Select(s => s.SharedWithUserId).ToHashSet();
        }
    }

    private void OnSearchInput()
    {
        searchDebounceTimer?.Dispose();
        searchDebounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(() =>
            {
                PerformSearch();
                StateHasChanged();
            });
        }, null, 300, Timeout.Infinite);
    }

    private void PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(searchTerm))
        {
            filteredUsers = null;
            return;
        }

        isSearching = true;
        var term = searchTerm.ToLowerInvariant();
        filteredUsers = allUsers?
            .Where(u => u.UserId != UserId && // Don't show current user
                        u.UserId != Document?.UploadedByUserId && // Don't show document owner
                        (u.DisplayName.ToLowerInvariant().Contains(term) ||
                         u.Email.ToLowerInvariant().Contains(term)))
            .Take(10)
            .ToList();
        isSearching = false;
    }

    private async Task ShareWithUser(int sharedWithUserId)
    {
        if (Document == null) return;

        isSharing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var success = await DocumentService.ShareDocumentAsync(Document.DocumentId, UserId, sharedWithUserId);
            if (success)
            {
                selectedUserIds.Add(sharedWithUserId);
                successMessage = "Document shared successfully!";
                await Task.Delay(1000);
                await OnShareComplete.InvokeAsync();
            }
            else
            {
                errorMessage = "Failed to share document. You may not have permission.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSharing = false;
        }
    }

    private async Task ShareWithProject()
    {
        if (Document == null || selectedProjectId == 0) return;

        isSharing = true;
        errorMessage = null;
        successMessage = null;

        try
        {
            var success = await DocumentService.ShareDocumentWithProjectAsync(Document.DocumentId, selectedProjectId, UserId);
            if (success)
            {
                successMessage = "Document shared with all project members!";
                await Task.Delay(1500);
                await OnShareComplete.InvokeAsync();
            }
            else
            {
                errorMessage = "Failed to share with project. You may not have permission or project has no members.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSharing = false;
        }
    }

    private void ResetState()
    {
        searchTerm = "";
        filteredUsers = null;
        selectedProjectId = 0;
        selectedUserIds.Clear();
        errorMessage = null;
        successMessage = null;
        searchDebounceTimer?.Dispose();
    }

    public void Dispose()
    {
        searchDebounceTimer?.Dispose();
    }
}
