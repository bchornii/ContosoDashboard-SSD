@using ContosoDashboard.Services
@using ContosoDashboard.Models
@using Microsoft.AspNetCore.Components.Forms
@inject IDocumentService DocumentService
@inject IProjectService ProjectService

@if (IsVisible)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Upload Document</h5>
                    <button type="button" class="btn-close" @onclick="Close" aria-label="Close"></button>
                </div>
                <EditForm Model="@uploadRequest" OnValidSubmit="HandleUpload">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                @errorMessage
                                <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(successMessage))
                        {
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                @successMessage
                                <button type="button" class="btn-close" @onclick="() => successMessage = null"></button>
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">File <span class="text-danger">*</span></label>
                            <InputFile @key="fileInputKey" class="form-control" OnChange="OnFileSelected" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.jpg,.jpeg,.png" />
                            <div class="form-text">Max size: 25 MB. Allowed: PDF, Word, Excel, PowerPoint, Text, Images</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Title <span class="text-danger">*</span></label>
                            <InputText @bind-Value="uploadRequest.Title" class="form-control" required />
                            <ValidationMessage For="@(() => uploadRequest.Title)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Category <span class="text-danger">*</span></label>
                            <InputSelect @bind-Value="uploadRequest.Category" class="form-select" required>
                                <option value="">-- Select Category --</option>
                                <option value="Report">Report</option>
                                <option value="Specification">Specification</option>
                                <option value="Presentation">Presentation</option>
                                <option value="Image">Image</option>
                                <option value="Spreadsheet">Spreadsheet</option>
                                <option value="Other">Other</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => uploadRequest.Category)" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <InputTextArea @bind-Value="uploadRequest.Description" class="form-control" rows="3" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Project (Optional)</label>
                            <InputSelect @bind-Value="uploadRequest.ProjectId" class="form-select">
                                <option value="">-- Personal Document --</option>
                                @if (userProjects != null)
                                {
                                    @foreach (var project in userProjects)
                                    {
                                        <option value="@project.ProjectId">@project.Name</option>
                                    }
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Tags (comma-separated)</label>
                            <InputText @bind-Value="uploadRequest.Tags" class="form-control" placeholder="e.g., design, q1-2026, draft" />
                        </div>

                        @if (isUploading)
                        {
                            <div class="mb-3">
                                <div class="progress">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%">Uploading...</div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="Close" disabled="@isUploading">Cancel</button>
                        <button type="submit" class="btn btn-primary" disabled="@(selectedFile == null || isUploading)">
                            <i class="bi bi-upload"></i> Upload
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public EventCallback OnUploadComplete { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public int UserId { get; set; }
    [Parameter] public int? PresetProjectId { get; set; }

    private DocumentUploadRequest uploadRequest = new();
    private IBrowserFile? selectedFile;
    private List<Project>? userProjects;
    private bool isUploading = false;
    private string? errorMessage;
    private string? successMessage;
    private int fileInputKey = 0;

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible && userProjects == null && UserId > 0)
        {
            userProjects = await ProjectService.GetUserProjectsAsync(UserId);
            uploadRequest = new DocumentUploadRequest
            {
                Title = string.Empty,
                Category = string.Empty,
                ProjectId = PresetProjectId
            };
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        errorMessage = null;

        // Auto-populate title if empty
        if (string.IsNullOrWhiteSpace(uploadRequest.Title) && selectedFile != null)
        {
            uploadRequest.Title = Path.GetFileNameWithoutExtension(selectedFile.Name);
        }
    }

    private async Task HandleUpload()
    {
        if (selectedFile == null)
        {
            errorMessage = "Please select a file to upload.";
            return;
        }

        isUploading = true;
        errorMessage = null;
        successMessage = null;
        StateHasChanged();

        try
        {
            uploadRequest.File = selectedFile;
            var result = await DocumentService.UploadDocumentAsync(UserId, uploadRequest);

            if (result.Success)
            {
                successMessage = $"'{uploadRequest.Title}' uploaded successfully!";
                await Task.Delay(1000);
                await OnUploadComplete.InvokeAsync();
                ResetForm();
            }
            else
            {
                errorMessage = result.ErrorMessage ?? "Upload failed.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }

    private void ResetForm()
    {
        selectedFile = null;
        uploadRequest = new DocumentUploadRequest { Title = string.Empty, Category = string.Empty };
        errorMessage = null;
        successMessage = null;
        fileInputKey++; // Force InputFile to reset
    }

    private async Task Close()
    {
        ResetForm();
        await OnClose.InvokeAsync();
    }
}
